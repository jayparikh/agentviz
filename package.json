{
  "name": "agentviz",
  "version": "1.0.2",
  "description": "Session replay visualizer for AI agent workflows (Claude Code, VS Code, Copilot CLI)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayparikh/agentviz.git"
  },
  "keywords": [
    "ai",
    "agent",
    "visualization",
    "claude",
    "copilot",
    "vscode",
    "session",
    "replay",
    "devtools"
  ],
  "bin": {
    "agentviz": "bin/agentviz.js"
  },
  "files": [
    "bin",
    "mcp",
    "dist",
    "routes",
    "server.js",
    "config.js",
    "src/lib",
    "src/hooks"
  ],
  "scripts": {
    "start": "npm run build && node ./bin/agentviz.js",
    "start:debug": "npm run build:debug && node ./bin/agentviz.js",
    "dev": "vite",
    "dev:test": "vite --mode test --host 127.0.0.1",
    "build": "vite build",
    "build:debug": "vite build --mode debug",
    "preview": "vite preview",
    "prepare": "npm run build",
    "test": "vitest run --maxWorkers=2",
    "test:v2": "vitest run --maxWorkers=2 src/__tests__/v2Shell.test.jsx src/__tests__/v2GoldenData.test.js src/__tests__/v2GoldenFormats.test.js src/__tests__/v2GoldenUi.test.jsx src/__tests__/appRegression.test.jsx src/__tests__/tokenAccounting.test.js",
    "test:e2e": "playwright test",
    "test:e2e:v2": "playwright test tests/e2e/v2-smoke.spec.js",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@github/copilot-sdk": "0.2.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "elkjs": "^0.11.1",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.0"
  }
}
